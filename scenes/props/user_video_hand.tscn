[ext_resource type="Script" path="res://scripts/user_video_hand.gd" id="1"]

[sub_resource type="Shader" id="SourceSkin"]
code = "shader_type canvas_item;
uniform float skin_mid = 0.45;
void fragment() {
 vec4 source = texture(TEXTURE, UV);
 float skin = smoothstep(0.008,0.024,source.r-source.g)*smoothstep(0.02,0.050,source.r-source.b);
 float light = clamp((dot(source.rgb,vec3(0.3333))-skin_mid)*2.4+0.68,0.15,0.95);
 vec3 tone = mix(vec3(0.68,0.44,0.27),vec3(1.0,0.87,0.68),light);
 COLOR = vec4(tone,skin);
}"

[sub_resource type="ShaderMaterial" id="SourceMaterial"]
shader = SubResource("SourceSkin")

